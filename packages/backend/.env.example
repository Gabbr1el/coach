NODE_ENV=development
HOST=0.0.0.0
PORT=4310
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
SECURITY_WEBHOOK_RATE_LIMIT_MAX=30
TRUST_PROXY_HOPS=0
DATABASE_URL=postgres://coach_runtime:coach_runtime_local@localhost:5432/coach
TEST_DATABASE_URL=postgres://coach_runtime:coach_runtime_local@localhost:5432/coach_test
MIGRATION_DATABASE_URL=postgres://coach_migrator:coach_migrator_local@localhost:5432/coach
AUTH_MODE=supabase
AUTH_JWT_MODE=legacy-hs256
AUTH_ISSUER=http://localhost:9999
AUTH_AUDIENCE=authenticated
AUTH_JWT_LEGACY_SECRET=local-only-secret-at-least-32-characters
AUTH_SESSION_CLAIM=session_id
AUTH_SESSION_CLAIM_VERIFIED_IMMUTABLE=false
AUTH_PUBLIC_URL=http://localhost:9999
AUTH_PUBLIC_KEY=replace-with-local-anon-key
AUTH_ADMIN_KEY=server-only-never-expose-to-electron
AUTH_SESSION_REVOKE_URL=http://localhost:9998/revoke
AUTH_SESSION_REVOKE_KEY=local-revoke-adapter-secret-32-bytes-minimum
AUTH_SESSION_REVOKE_MODE=user-global
REVOCATION_WORKER_INTERVAL_MS=5000
SECURITY_RECONCILIATION_WEBHOOK_SECRET=local-security-webhook-secret-32-bytes-minimum
SYNC_CURSOR_SECRET=local-sync-cursor-secret-at-least-32-bytes
SYNC_BOOTSTRAP_TTL_SECONDS=3600
SYNC_MAX_OFFLINE_MUTATION_AGE_DAYS=120
LOG_LEVEL=info
